<div class="max-w-4xl mx-auto mt-10">
  <div class="flex justify-between items-center mb-6">
    <h1 class="font-bold text-4xl">Your Haircuts</h1>
    <%= link_to "New Haircut", new_haircut_path, class: "bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded" %>
  </div>

  <% if @haircuts.empty? %>
    <p>You don't have any haircuts yet.</p>
  <% else %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% @haircuts.each do |haircut| %>
        <div class="bg-white rounded-lg shadow-md overflow-hidden">
          <% if haircut.image.attached? %>
            <%= image_tag haircut.image, class: "w-full h-48 object-cover" %>
          <% end %>
          <div class="p-4">
            <p class="text-gray-600"><strong>Client:</strong> <%= haircut.client.email_address %></p>
            <p class="text-gray-600"><strong>Barber:</strong> <%= haircut.barber.email_address %></p>
            <p class="mt-2"><%= haircut.details %></p>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
