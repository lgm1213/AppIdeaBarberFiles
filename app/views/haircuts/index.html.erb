<div class="max-w-6xl mx-auto">
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-8 gap-4">
    <div>
      <h1 class="font-bold text-3xl text-slate-800">Your Haircuts</h1>
      <p class="text-slate-500 mt-1">Browse your haircut history and portfolio</p>
    </div>
    <%= link_to new_haircut_path, class: "inline-flex items-center bg-gradient-to-r from-indigo-500 to-purple-600 hover:from-indigo-600 hover:to-purple-700 text-white font-semibold py-2.5 px-5 rounded-xl shadow-md hover:shadow-lg transition-all" do %>
      <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
      </svg>
      New Haircut
    <% end %>
  </div>

  <% if @haircuts.empty? %>
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-12 text-center">
      <div class="w-16 h-16 bg-slate-100 rounded-full flex items-center justify-center mx-auto mb-4">
        <svg class="w-8 h-8 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.121 14.121L19 19m-7-7l7-7m-7 7l-2.879 2.879M12 12L9.121 9.121m0 5.758a3 3 0 10-4.243 4.243 3 3 0 004.243-4.243zm0-5.758a3 3 0 10-4.243-4.243 3 3 0 004.243 4.243z"></path>
        </svg>
      </div>
      <h3 class="text-lg font-semibold text-slate-700 mb-2">No haircuts yet</h3>
      <p class="text-slate-500 mb-6">Add your first haircut to start building your portfolio.</p>
      <%= link_to "Add a Haircut", new_haircut_path, class: "inline-flex items-center text-indigo-600 hover:text-indigo-700 font-medium" %>
    </div>
  <% else %>
    <div data-controller="carousel" class="relative">
      <div data-carousel-target="container" class="flex overflow-x-scroll snap-x snap-mandatory scroll-smooth gap-4 pb-4 -mx-2 px-2 scrollbar-hide" style="scrollbar-width: none; -ms-overflow-style: none;">
        <% @haircuts.each do |haircut| %>
          <div class="snap-center shrink-0 w-full sm:w-80 md:w-96">
            <%= link_to haircut_path(haircut), class: "block bg-white rounded-2xl shadow-sm border border-slate-200 hover:shadow-lg transition-all overflow-hidden group h-full" do %>
              <% if haircut.images.attached? %>
                <div class="relative overflow-hidden">
                  <%= image_tag haircut.images.first, class: "w-full h-56 object-cover group-hover:scale-105 transition-transform duration-300" %>
                  <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent"></div>
                  <% if haircut.images.count > 1 %>
                    <span class="absolute top-2 right-2 bg-black/50 text-white text-xs font-medium px-2 py-1 rounded-lg"><%= haircut.images.count %> photos</span>
                  <% end %>
                </div>
              <% else %>
                <div class="w-full h-56 bg-gradient-to-br from-slate-100 to-slate-200 flex items-center justify-center">
                  <svg class="w-16 h-16 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                  </svg>
                </div>
              <% end %>
              <div class="p-5">
                <div class="flex items-center gap-3 mb-4">
                  <div class="flex -space-x-2">
                    <div class="w-8 h-8 bg-gradient-to-br from-indigo-400 to-purple-500 rounded-full flex items-center justify-center text-white font-semibold text-xs ring-2 ring-white">
                      <%= haircut.client.first_name&.first&.upcase || 'C' %>
                    </div>
                    <div class="w-8 h-8 bg-gradient-to-br from-emerald-400 to-teal-500 rounded-full flex items-center justify-center text-white font-semibold text-xs ring-2 ring-white">
                      <%= haircut.barber.first_name&.first&.upcase || 'B' %>
                    </div>
                  </div>
                  <div class="text-xs text-slate-500">
                    <span class="font-medium text-slate-700"><%= haircut.client.first_name || haircut.client.email_address.split('@').first %></span>
                    <span class="mx-1">&</span>
                    <span class="font-medium text-slate-700"><%= haircut.barber.first_name || haircut.barber.email_address.split('@').first %></span>
                  </div>
                </div>
                <p class="text-slate-600 text-sm leading-relaxed line-clamp-3"><%= haircut.details %></p>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>

      <button data-action="carousel#prev" class="absolute top-1/2 -left-4 transform -translate-y-1/2 w-12 h-12 bg-white text-slate-700 hover:text-indigo-600 rounded-full shadow-lg hover:shadow-xl transition-all z-10 flex items-center justify-center border border-slate-200">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
      </button>
      <button data-action="carousel#next" class="absolute top-1/2 -right-4 transform -translate-y-1/2 w-12 h-12 bg-white text-slate-700 hover:text-indigo-600 rounded-full shadow-lg hover:shadow-xl transition-all z-10 flex items-center justify-center border border-slate-200">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </button>
    </div>
  <% end %>
</div>
