<div class="min-h-[calc(100vh-8rem)] flex items-center justify-center">
  <div class="w-full max-w-2xl">
    <%= link_to haircuts_path, class: "inline-flex items-center text-slate-500 hover:text-indigo-600 font-medium mb-6 transition-colors" do %>
      <svg class="w-5 h-5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
      </svg>
      Back to Haircuts
    <% end %>

    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
      <div class="flex flex-col md:flex-row">
        <%# Image slideshow panel %>
        <div class="md:w-2/5 shrink-0" data-controller="slideshow">
          <div class="relative bg-slate-100 h-64 md:h-full md:min-h-[20rem]">
            <% if @haircut.images.attached? %>
              <% @haircut.images.each_with_index do |img, i| %>
                <div data-slideshow-target="slide" class="<%= 'hidden' unless i == 0 %> absolute inset-0">
                  <%= image_tag img, class: "w-full h-full object-cover" %>
                </div>
              <% end %>

              <% if @haircut.images.count > 1 %>
                <button data-action="slideshow#prev" class="absolute left-2 top-1/2 -translate-y-1/2 w-8 h-8 bg-black/40 hover:bg-black/60 text-white rounded-full flex items-center justify-center transition-colors z-10">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                  </svg>
                </button>
                <button data-action="slideshow#next" class="absolute right-2 top-1/2 -translate-y-1/2 w-8 h-8 bg-black/40 hover:bg-black/60 text-white rounded-full flex items-center justify-center transition-colors z-10">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                  </svg>
                </button>
                <span data-slideshow-target="counter" class="absolute bottom-2 right-2 bg-black/50 text-white text-xs font-medium px-2 py-1 rounded-lg z-10">1 / <%= @haircut.images.count %></span>
              <% end %>
            <% else %>
              <div class="w-full h-full flex items-center justify-center">
                <svg class="w-16 h-16 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                </svg>
              </div>
            <% end %>
          </div>
        </div>

        <%# Details panel %>
        <div class="p-8 flex-1 flex flex-col justify-center">
          <div class="flex items-center gap-4 mb-6">
            <div class="flex -space-x-3">
              <div class="w-10 h-10 bg-gradient-to-br from-indigo-400 to-purple-500 rounded-full flex items-center justify-center text-white font-semibold text-xs ring-2 ring-white">
                <%= @haircut.client.first_name&.first&.upcase || 'C' %>
              </div>
              <div class="w-10 h-10 bg-gradient-to-br from-emerald-400 to-teal-500 rounded-full flex items-center justify-center text-white font-semibold text-xs ring-2 ring-white">
                <%= @haircut.barber.first_name&.first&.upcase || 'B' %>
              </div>
            </div>
            <div>
              <p class="text-xs text-slate-500">Client</p>
              <p class="font-medium text-slate-800 text-sm"><%= @haircut.client.first_name %> <%= @haircut.client.last_name %></p>
            </div>
            <div class="ml-2">
              <p class="text-xs text-slate-500">Barber</p>
              <p class="font-medium text-slate-800 text-sm"><%= @haircut.barber.first_name %> <%= @haircut.barber.last_name %></p>
            </div>
          </div>

          <div class="border-t border-slate-100 pt-5">
            <h2 class="text-xs font-medium text-slate-500 uppercase tracking-wide mb-2">Details</h2>
            <p class="text-slate-700 text-sm leading-relaxed"><%= @haircut.details.presence || "No details provided." %></p>
          </div>

          <div class="border-t border-slate-100 pt-4 mt-5">
            <p class="text-xs text-slate-400">Created <%= time_ago_in_words(@haircut.created_at) %> ago</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
