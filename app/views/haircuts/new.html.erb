<div class="max-w-lg mx-auto">
  <div class="text-center mb-8">
    <div class="w-16 h-16 bg-gradient-to-br from-indigo-500 to-purple-600 rounded-2xl flex items-center justify-center mx-auto mb-4 shadow-lg">
      <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.121 14.121L19 19m-7-7l7-7m-7 7l-2.879 2.879M12 12L9.121 9.121m0 5.758a3 3 0 10-4.243 4.243 3 3 0 004.243-4.243zm0-5.758a3 3 0 10-4.243-4.243 3 3 0 004.243 4.243z"></path>
      </svg>
    </div>
    <h1 class="font-bold text-3xl text-slate-800">New Haircut</h1>
    <p class="text-slate-500 mt-2">Document a new haircut</p>
  </div>

  <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-8">
    <%= form_with(model: @haircut, class: "space-y-6") do |form| %>
      <% if @haircut.errors.any? %>
        <div class="bg-red-50 border border-red-200 rounded-xl p-4">
          <div class="flex items-center mb-2">
            <svg class="w-5 h-5 text-red-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span class="font-medium text-red-800">Please fix the following errors:</span>
          </div>
          <ul class="list-disc list-inside text-red-700 text-sm space-y-1">
            <% @haircut.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <% if current_user.barber? %>
        <div>
          <%= form.label :client_id, class: "block text-sm font-semibold text-slate-700 mb-2" %>
          <%= form.collection_select :client_id, User.clients, :id, :email_address, { prompt: "Select a client" }, { class: "block w-full rounded-xl border-slate-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 py-3 px-4 bg-slate-50 focus:bg-white transition-colors" } %>
        </div>
      <% else %>
        <div>
          <%= form.label :barber_id, class: "block text-sm font-semibold text-slate-700 mb-2" %>
          <%= form.collection_select :barber_id, User.barbers, :id, :email_address, { prompt: "Select a barber" }, { class: "block w-full rounded-xl border-slate-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 py-3 px-4 bg-slate-50 focus:bg-white transition-colors" } %>
        </div>
      <% end %>

      <div>
        <%= form.label :details, class: "block text-sm font-semibold text-slate-700 mb-2" %>
        <%= form.text_area :details, rows: 4, class: "block w-full rounded-xl border-slate-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 py-3 px-4 bg-slate-50 focus:bg-white transition-colors resize-none", placeholder: "Describe the haircut style, techniques used, etc." %>
      </div>

      <div>
        <%= form.label :images, "Photos", class: "block text-sm font-semibold text-slate-700 mb-2" %>
        <div class="mt-1 flex justify-center px-6 pt-5 pb-6 border-2 border-slate-300 border-dashed rounded-xl hover:border-indigo-400 transition-colors bg-slate-50">
          <div class="space-y-2 text-center">
            <svg class="mx-auto h-12 w-12 text-slate-400" stroke="currentColor" fill="none" viewBox="0 0 48 48">
              <path d="M28 8H12a4 4 0 00-4 4v20m32-12v8m0 0v8a4 4 0 01-4 4H12a4 4 0 01-4-4v-4m32-4l-3.172-3.172a4 4 0 00-5.656 0L28 28M8 32l9.172-9.172a4 4 0 015.656 0L28 28m0 0l4 4m4-24h8m-4-4v8m-12 4h.02" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <div class="flex text-sm text-slate-600 justify-center">
              <label class="relative cursor-pointer rounded-md font-medium text-indigo-600 hover:text-indigo-500">
                <span>Upload photos</span>
                <%= form.file_field :images, class: "sr-only", accept: "image/*", multiple: true %>
              </label>
              <p class="pl-1">or drag and drop</p>
            </div>
            <p class="text-xs text-slate-500">PNG, JPG, GIF up to 10MB</p>
          </div>
        </div>
      </div>

      <div class="pt-4">
        <%= form.submit "Create Haircut", class: "w-full bg-gradient-to-r from-indigo-500 to-purple-600 hover:from-indigo-600 hover:to-purple-700 text-white font-semibold py-3.5 px-6 rounded-xl shadow-md hover:shadow-lg transition-all cursor-pointer" %>
      </div>
    <% end %>
  </div>

  <div class="text-center mt-6">
    <%= link_to haircuts_path, class: "inline-flex items-center text-slate-600 hover:text-indigo-600 font-medium transition-colors" do %>
      <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
      </svg>
      Back to Haircuts
    <% end %>
  </div>
</div>
