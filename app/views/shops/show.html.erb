<div class="max-w-6xl mx-auto">
  <!-- Header -->
  <div class="mb-8">
    <%= link_to shops_path, class: "inline-flex items-center text-slate-500 hover:text-slate-700 text-sm mb-4" do %>
      <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
      </svg>
      Back to Shops
    <% end %>
    <h1 class="font-bold text-3xl text-slate-800"><%= @shop.name %></h1>
    <p class="text-slate-500 mt-1"><%= @shop.address %></p>
  </div>

  <!-- Tab Navigation -->
  <div class="border-b border-slate-200 mb-6">
    <nav class="flex space-x-8">
      <%= link_to shop_path(@shop, tab: "staff"),
            class: "pb-3 px-1 border-b-2 font-medium text-sm #{@active_tab == 'staff' ? 'border-indigo-500 text-indigo-600' : 'border-transparent text-slate-500 hover:text-slate-700 hover:border-slate-300'}" do %>
        Chairs & Staff
      <% end %>
      <%= link_to shop_path(@shop, tab: "revenue"),
            class: "pb-3 px-1 border-b-2 font-medium text-sm #{@active_tab == 'revenue' ? 'border-indigo-500 text-indigo-600' : 'border-transparent text-slate-500 hover:text-slate-700 hover:border-slate-300'}" do %>
        Revenue
      <% end %>
      <%= link_to shop_path(@shop, tab: "inventory"),
            class: "pb-3 px-1 border-b-2 font-medium text-sm #{@active_tab == 'inventory' ? 'border-indigo-500 text-indigo-600' : 'border-transparent text-slate-500 hover:text-slate-700 hover:border-slate-300'}" do %>
        Inventory
      <% end %>
    </nav>
  </div>

  <!-- Tab Content -->
  <% case @active_tab %>
  <% when "staff" %>
    <%= render "shops/staff_tab" %>
  <% when "revenue" %>
    <%= render "shops/revenue_tab" %>
  <% when "inventory" %>
    <%= render "shops/inventory_tab" %>
  <% end %>
</div>
