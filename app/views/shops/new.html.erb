<div class="max-w-lg mx-auto">
  <div class="text-center mb-8">
    <div class="w-16 h-16 bg-gradient-to-br from-indigo-500 to-purple-600 rounded-2xl flex items-center justify-center mx-auto mb-4 shadow-lg">
      <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
      </svg>
    </div>
    <h1 class="font-bold text-3xl text-slate-800">New Shop</h1>
    <p class="text-slate-500 mt-2">Add a new barbershop location</p>
  </div>

  <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-8">
    <%= form_with(model: @shop, class: "space-y-6") do |form| %>
      <% if @shop.errors.any? %>
        <div class="bg-red-50 border border-red-200 rounded-xl p-4">
          <div class="flex items-center mb-2">
            <svg class="w-5 h-5 text-red-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span class="font-medium text-red-800">Please fix the following errors:</span>
          </div>
          <ul class="list-disc list-inside text-red-700 text-sm space-y-1">
            <% @shop.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <%= form.label :name, class: "block text-sm font-semibold text-slate-700 mb-2" %>
        <%= form.text_field :name, class: "block w-full rounded-xl border-slate-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 py-3 px-4 bg-slate-50 focus:bg-white transition-colors", placeholder: "e.g., Downtown Barbershop" %>
      </div>

      <div>
        <%= form.label :address, class: "block text-sm font-semibold text-slate-700 mb-2" %>
        <div class="relative">
          <div class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-400">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
          </div>
          <%= form.text_field :address, class: "block w-full rounded-xl border-slate-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 py-3 pl-12 pr-4 bg-slate-50 focus:bg-white transition-colors", placeholder: "123 Main Street, City, State" %>
        </div>
      </div>

      <div class="pt-4">
        <%= form.submit "Create Shop", class: "w-full bg-gradient-to-r from-indigo-500 to-purple-600 hover:from-indigo-600 hover:to-purple-700 text-white font-semibold py-3.5 px-6 rounded-xl shadow-md hover:shadow-lg transition-all cursor-pointer" %>
      </div>
    <% end %>
  </div>

  <div class="text-center mt-6">
    <%= link_to shops_path, class: "inline-flex items-center text-slate-600 hover:text-indigo-600 font-medium transition-colors" do %>
      <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
      </svg>
      Back to Shops
    <% end %>
  </div>
</div>
