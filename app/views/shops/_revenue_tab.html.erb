<!-- Date Range Filter -->
<div class="flex flex-wrap gap-2 mb-6">
  <% %w[today this_week this_month this_year all_time].each do |range| %>
    <% label = range.titleize %>
    <%= link_to label, shop_path(@shop, tab: "revenue", range: range),
          class: "px-3 py-1.5 rounded-lg text-sm font-medium transition-colors #{@date_range == range ? 'bg-indigo-600 text-white' : 'bg-white border border-slate-300 text-slate-600 hover:bg-slate-50'}" %>
  <% end %>
</div>

<!-- Action Buttons -->
<div class="flex flex-wrap gap-3 mb-6">
  <%= link_to new_shop_transaction_path(@shop, type: "income"), class: "inline-flex items-center bg-green-600 hover:bg-green-700 text-white font-semibold py-2 px-4 rounded-xl shadow-md transition-all text-sm" do %>
    <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
    </svg>
    Add Income
  <% end %>
  <%= link_to new_shop_transaction_path(@shop, type: "expense"), class: "inline-flex items-center bg-red-600 hover:bg-red-700 text-white font-semibold py-2 px-4 rounded-xl shadow-md transition-all text-sm" do %>
    <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
    </svg>
    Add Expense
  <% end %>
</div>

<!-- Summary Cards -->
<div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
  <div class="bg-white rounded-2xl shadow-sm border border-green-200 p-5">
    <p class="text-sm font-medium text-green-600 mb-1">Total Revenue</p>
    <p class="text-2xl font-bold text-green-700">$<%= number_with_precision(@total_revenue, precision: 2, delimiter: ',') %></p>
  </div>
  <div class="bg-white rounded-2xl shadow-sm border border-red-200 p-5">
    <p class="text-sm font-medium text-red-600 mb-1">Total Expenses</p>
    <p class="text-2xl font-bold text-red-700">$<%= number_with_precision(@total_expenses, precision: 2, delimiter: ',') %></p>
  </div>
  <div class="bg-white rounded-2xl shadow-sm border border-indigo-200 p-5">
    <p class="text-sm font-medium text-indigo-600 mb-1">Net Revenue</p>
    <p class="text-2xl font-bold <%= @net_revenue >= 0 ? 'text-indigo-700' : 'text-red-700' %>">$<%= number_with_precision(@net_revenue, precision: 2, delimiter: ',') %></p>
  </div>
</div>

<!-- Revenue by Barber -->
<% if @revenue_by_barber.any? %>
  <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-5 mb-6">
    <h3 class="font-semibold text-slate-700 mb-3">Revenue by Barber</h3>
    <div class="space-y-2">
      <% @revenue_by_barber.each do |barber_id, amount| %>
        <% barber = @barbers_map[barber_id] %>
        <div class="flex items-center justify-between py-2 border-b border-slate-100 last:border-0">
          <span class="text-sm text-slate-700 font-medium"><%= barber&.first_name %> <%= barber&.last_name %></span>
          <span class="text-sm font-semibold text-green-700">$<%= number_with_precision(amount, precision: 2, delimiter: ',') %></span>
        </div>
      <% end %>
    </div>
  </div>
<% end %>

<!-- Recent Transactions -->
<h3 class="font-semibold text-slate-700 mb-3">Transactions</h3>
<% if @transactions.any? %>
  <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-slate-200">
        <thead class="bg-slate-50">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-medium text-slate-500 uppercase">Date</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-slate-500 uppercase">Type</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-slate-500 uppercase">Category</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-slate-500 uppercase">Description</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-slate-500 uppercase">Barber</th>
            <th class="px-4 py-3 text-right text-xs font-medium text-slate-500 uppercase">Amount</th>
            <th class="px-4 py-3 text-right text-xs font-medium text-slate-500 uppercase">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200">
          <% @transactions.each do |txn| %>
            <tr>
              <td class="px-4 py-3 text-sm text-slate-600"><%= txn.transaction_date.strftime("%b %d, %Y") %></td>
              <td class="px-4 py-3">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= txn.transaction_type == 'income' ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' %>">
                  <%= txn.transaction_type.capitalize %>
                </span>
              </td>
              <td class="px-4 py-3 text-sm text-slate-600"><%= txn.category %></td>
              <td class="px-4 py-3 text-sm text-slate-600"><%= txn.description %></td>
              <td class="px-4 py-3 text-sm text-slate-600"><%= txn.barber ? "#{txn.barber.first_name} #{txn.barber.last_name}" : "—" %></td>
              <td class="px-4 py-3 text-sm font-semibold text-right <%= txn.transaction_type == 'income' ? 'text-green-700' : 'text-red-700' %>">
                <%= txn.transaction_type == 'income' ? '+' : '-' %>$<%= number_with_precision(txn.amount_dollars, precision: 2, delimiter: ',') %>
              </td>
              <td class="px-4 py-3 text-sm text-right space-x-2">
                <%= link_to "Edit", edit_shop_transaction_path(@shop, txn), class: "text-indigo-600 hover:text-indigo-700 font-medium" %>
                <%= link_to "Delete", shop_transaction_path(@shop, txn), data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }, class: "text-red-600 hover:text-red-700 font-medium" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% else %>
  <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-8 text-center">
    <p class="text-slate-500">No transactions yet. Start tracking your revenue and expenses.</p>
  </div>
<% end %>
