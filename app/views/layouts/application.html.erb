<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "App Idea Barber Files" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="App Idea Barber Files">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-100">
    <header class="bg-white shadow">
      <nav class="container mx-auto px-5 py-4 flex justify-between items-center">
        <%= link_to "App Idea Barber Files", root_path, class: "font-bold text-xl" %>
        <div>
          <% if current_user %>
            <span class="mr-4">Welcome, <%= current_user.first_name %></span>
            <%= link_to "Haircuts", haircuts_path, class: "mr-4" %>
            <%= link_to "Appointments", appointments_path, class: "mr-4" %>
            <% if current_user.barber? %>
              <%= link_to "Shops", shops_path, class: "mr-4" %>
              <%= link_to "Email Clients", new_marketing_campaign_path, class: "mr-4" %>
            <% end %>
            <%= button_to "Logout", logout_path, method: :delete, class: "bg-red-500 hover:bg-red-700 text-white font-bold py-2 px-4 rounded" %>
          <% else %>
            <%= link_to "Login", login_path, class: "mr-4" %>
            <%= link_to "Sign Up", signup_path %>
          <% end %>
        </div>
      </nav>
    </header>
    <main class="container mx-auto mt-8 px-5">
      <% if notice %>
        <p class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative" role="alert"><%= notice %></p>
      <% end %>
      <% if alert %>
        <p class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative" role="alert"><%= alert %></p>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
