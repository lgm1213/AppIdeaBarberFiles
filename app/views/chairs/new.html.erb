<div class="max-w-lg mx-auto">
  <div class="text-center mb-8">
    <div class="w-16 h-16 bg-gradient-to-br from-indigo-500 to-purple-600 rounded-2xl flex items-center justify-center mx-auto mb-4 shadow-lg">
      <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"></path>
      </svg>
    </div>
    <h1 class="font-bold text-3xl text-slate-800">New Chair</h1>
    <p class="text-slate-500 mt-2">Add a new barber chair to <%= @shop.name %></p>
  </div>

  <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-8">
    <%= form_with(model: [@shop, @chair], class: "space-y-6") do |form| %>
      <% if @chair.errors.any? %>
        <div class="bg-red-50 border border-red-200 rounded-xl p-4">
          <div class="flex items-center mb-2">
            <svg class="w-5 h-5 text-red-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span class="font-medium text-red-800">Please fix the following errors:</span>
          </div>
          <ul class="list-disc list-inside text-red-700 text-sm space-y-1">
            <% @chair.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <%= form.label :name, class: "block text-sm font-semibold text-slate-700 mb-2" %>
        <%= form.text_field :name, class: "block w-full rounded-xl border-slate-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 py-3 px-4 bg-slate-50 focus:bg-white transition-colors", placeholder: "e.g., Chair 1, Station A" %>
      </div>

      <div class="bg-slate-50 rounded-xl p-4">
        <label class="flex items-center cursor-pointer">
          <%= form.check_box :is_available, class: "h-5 w-5 text-indigo-600 focus:ring-indigo-500 border-slate-300 rounded-md" %>
          <span class="ml-3">
            <span class="block text-sm font-semibold text-slate-700">Available for booking</span>
            <span class="block text-xs text-slate-500">Clients can book appointments for this chair</span>
          </span>
        </label>
      </div>

      <div>
        <%= form.label :barber_id, "Assign to Barber", class: "block text-sm font-semibold text-slate-700 mb-2" %>
        <%= form.collection_select :barber_id, User.barbers, :id, :email_address, { include_blank: "Unassigned" }, { class: "block w-full rounded-xl border-slate-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 py-3 px-4 bg-slate-50 focus:bg-white transition-colors" } %>
        <p class="mt-2 text-xs text-slate-500">Optionally assign a barber to this chair</p>
      </div>

      <div class="pt-4">
        <%= form.submit "Create Chair", class: "w-full bg-gradient-to-r from-indigo-500 to-purple-600 hover:from-indigo-600 hover:to-purple-700 text-white font-semibold py-3.5 px-6 rounded-xl shadow-md hover:shadow-lg transition-all cursor-pointer" %>
      </div>
    <% end %>
  </div>

  <div class="text-center mt-6">
    <%= link_to shop_chairs_path(@shop), class: "inline-flex items-center text-slate-600 hover:text-indigo-600 font-medium transition-colors" do %>
      <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
      </svg>
      Back to Chairs
    <% end %>
  </div>
</div>
