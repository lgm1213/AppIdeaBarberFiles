<div class="max-w-lg mx-auto">
  <div class="text-center mb-8">
    <div class="w-16 h-16 bg-gradient-to-br from-indigo-500 to-purple-600 rounded-2xl flex items-center justify-center mx-auto mb-4 shadow-lg">
      <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
      </svg>
    </div>
    <h1 class="font-bold text-3xl text-slate-800">Create Account</h1>
    <p class="text-slate-500 mt-2">Join us to book or manage appointments</p>
  </div>

  <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-8">
    <%= form_with(model: @user, url: signup_path, class: "space-y-6") do |form| %>
      <% if @user.errors.any? %>
        <div class="bg-red-50 border border-red-200 rounded-xl p-4">
          <div class="flex items-center mb-2">
            <svg class="w-5 h-5 text-red-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span class="font-medium text-red-800">Please fix the following errors:</span>
          </div>
          <ul class="list-disc list-inside text-red-700 text-sm space-y-1">
            <% @user.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <%= form.label :first_name, class: "block text-sm font-semibold text-slate-700 mb-2" %>
          <%= form.text_field :first_name, class: "block w-full rounded-xl border-slate-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 py-3 px-4 bg-slate-50 focus:bg-white transition-colors", placeholder: "John" %>
        </div>

        <div>
          <%= form.label :last_name, class: "block text-sm font-semibold text-slate-700 mb-2" %>
          <%= form.text_field :last_name, class: "block w-full rounded-xl border-slate-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 py-3 px-4 bg-slate-50 focus:bg-white transition-colors", placeholder: "Doe" %>
        </div>
      </div>

      <div>
        <%= form.label :email_address, class: "block text-sm font-semibold text-slate-700 mb-2" %>
        <%= form.email_field :email_address, class: "block w-full rounded-xl border-slate-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 py-3 px-4 bg-slate-50 focus:bg-white transition-colors", placeholder: "you@example.com" %>
      </div>

      <div>
        <%= form.label :password, class: "block text-sm font-semibold text-slate-700 mb-2" %>
        <%= form.password_field :password, class: "block w-full rounded-xl border-slate-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 py-3 px-4 bg-slate-50 focus:bg-white transition-colors", placeholder: "Create a strong password" %>
        <p class="mt-2 text-xs text-slate-500">Must be at least 8 characters</p>
      </div>

      <div>
        <%= form.label :password_confirmation, "Confirm Password", class: "block text-sm font-semibold text-slate-700 mb-2" %>
        <%= form.password_field :password_confirmation, class: "block w-full rounded-xl border-slate-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 py-3 px-4 bg-slate-50 focus:bg-white transition-colors", placeholder: "Confirm your password" %>
      </div>

      <div>
        <%= form.label :role, "I am a...", class: "block text-sm font-semibold text-slate-700 mb-3" %>
        <div class="grid grid-cols-2 gap-4">
          <label class="relative cursor-pointer">
            <%= form.radio_button :role, 'client', class: "peer sr-only" %>
            <div class="border-2 border-slate-200 rounded-xl p-4 text-center peer-checked:border-indigo-500 peer-checked:bg-indigo-50 hover:border-slate-300 transition-all">
              <div class="w-12 h-12 bg-slate-100 peer-checked:bg-indigo-100 rounded-full flex items-center justify-center mx-auto mb-2">
                <svg class="w-6 h-6 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                </svg>
              </div>
              <span class="font-semibold text-slate-700">Client</span>
              <p class="text-xs text-slate-500 mt-1">Book appointments</p>
            </div>
          </label>

          <label class="relative cursor-pointer">
            <%= form.radio_button :role, 'barber', class: "peer sr-only" %>
            <div class="border-2 border-slate-200 rounded-xl p-4 text-center peer-checked:border-indigo-500 peer-checked:bg-indigo-50 hover:border-slate-300 transition-all">
              <div class="w-12 h-12 bg-slate-100 peer-checked:bg-indigo-100 rounded-full flex items-center justify-center mx-auto mb-2">
                <svg class="w-6 h-6 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.121 14.121L19 19m-7-7l7-7m-7 7l-2.879 2.879M12 12L9.121 9.121m0 5.758a3 3 0 10-4.243 4.243 3 3 0 004.243-4.243zm0-5.758a3 3 0 10-4.243-4.243 3 3 0 004.243 4.243z"></path>
                </svg>
              </div>
              <span class="font-semibold text-slate-700">Barber</span>
              <p class="text-xs text-slate-500 mt-1">Manage your business</p>
            </div>
          </label>
        </div>
      </div>

      <div class="pt-4">
        <%= form.submit "Create Account", class: "w-full bg-gradient-to-r from-indigo-500 to-purple-600 hover:from-indigo-600 hover:to-purple-700 text-white font-semibold py-3.5 px-6 rounded-xl shadow-md hover:shadow-lg transition-all cursor-pointer" %>
      </div>
    <% end %>
  </div>

  <div class="text-center mt-8">
    <p class="text-slate-600">
      Already have an account?
      <%= link_to "Sign in", login_path, class: "font-semibold text-indigo-600 hover:text-indigo-500 ml-1" %>
    </p>
  </div>
</div>
