<div class="max-w-md mx-auto mt-10">
  <h1 class="font-bold text-4xl text-center">New Appointment</h1>

  <%= form_with(model: @appointment, class: "space-y-4") do |form| %>
    <% if @appointment.errors.any? %>
      <div class="text-red-500">
        <ul>
          <% @appointment.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <% if current_user.barber? %>
      <div>
        <%= form.label :client_id, class: "block text-sm font-medium text-gray-700" %>
        <%= form.collection_select :client_id, User.clients, :id, :email_address, { prompt: "Select a client" }, { class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" } %>
      </div>
    <% else %>
      <div>
        <%= form.label :barber_id, class: "block text-sm font-medium text-gray-700" %>
        <%= form.collection_select :barber_id, User.barbers, :id, :email_address, { prompt: "Select a barber" }, { class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" } %>
      </div>
    <% end %>

    <div>
      <%= form.label :start_time, class: "block text-sm font-medium text-gray-700" %>
      <%= form.datetime_select :start_time, {}, { class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" } %>
    </div>

    <div>
      <%= form.label :end_time, class: "block text-sm font-medium text-gray-700" %>
      <%= form.datetime_select :end_time, {}, { class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" } %>
    </div>

    <% if current_user.barber? %>
      <div>
        <%= form.label :amount, "Amount (in dollars)", class: "block text-sm font-medium text-gray-700" %>
        <%= form.number_field :amount, step: 0.01, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
      </div>
    <% end %>

    <div>
      <%= form.submit "Create Appointment", class: "w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
    </div>
  <% end %>
</div>
