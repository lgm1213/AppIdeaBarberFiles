<div class="max-w-lg mx-auto">
  <div class="text-center mb-8">
    <div class="w-16 h-16 bg-gradient-to-br from-indigo-500 to-purple-600 rounded-2xl flex items-center justify-center mx-auto mb-4 shadow-lg">
      <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
      </svg>
    </div>
    <h1 class="font-bold text-3xl text-slate-800">New Appointment</h1>
    <p class="text-slate-500 mt-2">Schedule a new appointment</p>
  </div>

  <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-8">
    <%= form_with(model: @appointment, class: "space-y-6") do |form| %>
      <% if @appointment.errors.any? %>
        <div class="bg-red-50 border border-red-200 rounded-xl p-4">
          <div class="flex items-center mb-2">
            <svg class="w-5 h-5 text-red-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span class="font-medium text-red-800">Please fix the following errors:</span>
          </div>
          <ul class="list-disc list-inside text-red-700 text-sm space-y-1">
            <% @appointment.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <% if current_user.barber? %>
        <div>
          <%= form.label :client_id, class: "block text-sm font-semibold text-slate-700 mb-2" %>
          <%= form.collection_select :client_id, User.clients, :id, :email_address, { prompt: "Select a client" }, { class: "block w-full rounded-xl border-slate-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 py-3 px-4 bg-slate-50 focus:bg-white transition-colors" } %>
        </div>
      <% else %>
        <div>
          <%= form.label :barber_id, class: "block text-sm font-semibold text-slate-700 mb-2" %>
          <%= form.collection_select :barber_id, User.barbers, :id, :email_address, { prompt: "Select a barber" }, { class: "block w-full rounded-xl border-slate-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 py-3 px-4 bg-slate-50 focus:bg-white transition-colors" } %>
        </div>
      <% end %>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <%= form.label :start_time, class: "block text-sm font-semibold text-slate-700 mb-2" %>
          <div class="datetime-select-wrapper">
            <%= form.datetime_select :start_time, {}, { class: "rounded-lg border-slate-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 py-2 px-3 bg-slate-50 focus:bg-white transition-colors text-sm" } %>
          </div>
        </div>

        <div>
          <%= form.label :end_time, class: "block text-sm font-semibold text-slate-700 mb-2" %>
          <div class="datetime-select-wrapper">
            <%= form.datetime_select :end_time, {}, { class: "rounded-lg border-slate-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 py-2 px-3 bg-slate-50 focus:bg-white transition-colors text-sm" } %>
          </div>
        </div>
      </div>

      <% if current_user.barber? %>
        <div>
          <%= form.label :amount, "Amount (in dollars)", class: "block text-sm font-semibold text-slate-700 mb-2" %>
          <div class="relative">
            <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-500">$</span>
            <%= form.number_field :amount, step: 0.01, class: "block w-full rounded-xl border-slate-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 py-3 pl-8 pr-4 bg-slate-50 focus:bg-white transition-colors", placeholder: "0.00" %>
          </div>
        </div>
      <% end %>

      <div class="pt-4">
        <%= form.submit "Create Appointment", class: "w-full bg-gradient-to-r from-indigo-500 to-purple-600 hover:from-indigo-600 hover:to-purple-700 text-white font-semibold py-3.5 px-6 rounded-xl shadow-md hover:shadow-lg transition-all cursor-pointer" %>
      </div>
    <% end %>
  </div>

  <div class="text-center mt-6">
    <%= link_to appointments_path, class: "inline-flex items-center text-slate-600 hover:text-indigo-600 font-medium transition-colors" do %>
      <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
      </svg>
      Back to Appointments
    <% end %>
  </div>
</div>
